  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "mkdir -p $HOME/eas-tmp && TMPDIR=$HOME/eas-tmp eas build --platform android --local --profile preview && mkdir -p builds/apk && mv *.apk builds/apk/",
